# Copy to .env (git-ignored) or run scripts/setup-testnet.sh / scripts/make-env.js to generate it.
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
LEASHPAY_CONTRACT=vault.leashpay-c143d2.testnet
AGENT_ACCOUNT_ID=agent.leashpay-c143d2.testnet
# Function-call access key of the agent (ed25519:...), allowed to call ONLY request_payment on the vault
AGENT_PRIVATE_KEY=
OWNER_ACCOUNT_ID=leashpay-c143d2.testnet
# Testnet owner key, only needed for the dashboard's Approve/Reject/Pause/Policy buttons
OWNER_PRIVATE_KEY=
ENABLE_OWNER_ACTIONS=true
# Optional LLM planner; without it a deterministic rule-based parser is used
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PORT=3000
